        "currency",
        "baseCurrency",
        "date",
        "rate"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "currency": {
          "$ref": "#/$defs/currency"
        },
        "baseCurrency": {
          "$ref": "#/$defs/currency"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "rate": {
          "$ref": "#/$defs/rate"
        }
      }
    },
    "debt": {
      "type": "object",
      "additionalProperties": false,
