          "type": "integer"
        },
        "icon": {
          "$ref": "#/$defs/displayKey"
        },
        "color": {
          "$ref": "#/$defs/displayKey"
        }
      }
    },
    "budgetLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "categoryId",
