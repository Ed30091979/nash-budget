        "budgets": {
          "type": "array",
          "maxItems": 240,
          "items": {
            "$ref": "#/$defs/budget"
          },
          "minItems": 1
        },
        "goals": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/goal"
