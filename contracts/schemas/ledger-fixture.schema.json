      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "categoryId": {
          "$ref": "#/$defs/id"
        },
        "plannedMinor": {
          "$ref": "#/$defs/nonNegativeMoney"
        },
        "rolloverMinor": {
          "$ref": "#/$defs/nonNegativeMoney"
        },
        "adjustmentMinor": {
          "$ref": "#/$defs/money"
        },
        "active": {
          "type": "boolean"
        }
      }
