        "frequency": {
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "yearly"
          ]
        },
        "interval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "startDate": {
          "$ref": "#/$defs/date"
        },
        "endDate": {
          "$ref": "#/$defs/date"
        },
        "materializedThrough": {
          "$ref": "#/$defs/date"
        },
        "active": {
          "type": "boolean"
        }
      }
