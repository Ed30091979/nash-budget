    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "startDate",
        "endDate",
        "status",
        "plannedIncomeMinor",
        "warningThreshold",
        "lines"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "startDate": {
          "$ref": "#/$defs/date"
        },
        "endDate": {
          "$ref": "#/$defs/date"
        },
        "status": {
          "enum": [
            "draft",
            "open",
            "closed"
          ]
        },
        "plannedIncomeMinor": {
          "$ref": "#/$defs/nonNegativeMoney"
        },
        "warningThreshold": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "lines": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/budgetLine"
          }
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "linkedAccountId",
        "targetMinor",
        "openingContributedMinor",
        "plannedContributionMinor",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
