      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "occurredOn": {
          "$ref": "#/$defs/date"
        },
        "status": {
          "enum": [
            "posted",
            "pending",
            "draft"
          ]
        },
        "kind": {
          "enum": [
            "income",
            "expense",
            "refund",
            "transfer",
            "goal_contribution",
            "debt_out",
            "debt_in"
          ]
        },
        "amountMinor": {
          "$ref": "#/$defs/positiveMoney"
        },
        "accountId": {
          "$ref": "#/$defs/id"
        },
        "categoryId": {
          "$ref": "#/$defs/id"
        },
        "fromAccountId": {
          "$ref": "#/$defs/id"
        },
        "toAccountId": {
          "$ref": "#/$defs/id"
        },
        "goalId": {
          "$ref": "#/$defs/id"
        },
        "originalTransactionId": {
          "$ref": "#/$defs/id"
        },
        "debtId": {
          "$ref": "#/$defs/id"
        },
        "memberId": {
          "$ref": "#/$defs/id"
        },
        "note": {
          "$ref": "#/$defs/note"
        },
        "tagIds": {
          "$ref": "#/$defs/tagIds"
        },
        "recurringRuleId": {
          "$ref": "#/$defs/id"
        },
        "baseAmountMinor": {
          "$ref": "#/$defs/fieldMoney"
        },
        "baseCurrency": {
          "$ref": "#/$defs/currency"
        },
        "rate": {
          "$ref": "#/$defs/rate"
        },
        "toAmountMinor": {
          "$ref": "#/$defs/fieldMoney"
        },
        "debtAmountMinor": {
          "$ref": "#/$defs/fieldMoney"
        }
      },
      "dependentRequired": {
        "baseAmountMinor": [
          "baseCurrency",
          "rate"
        ],
        "baseCurrency": [
          "baseAmountMinor",
          "rate"
        ],
        "rate": [
          "baseAmountMinor",
          "baseCurrency"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "income",
                  "expense",
                  "refund",
                  "debt_out",
                  "debt_in"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "accountId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "expense",
                  "refund"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "categoryId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "refund"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "originalTransactionId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "transfer",
                  "goal_contribution"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "fromAccountId",
              "toAccountId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "goal_contribution"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "goalId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "debt_out",
                  "debt_in"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "debtId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "not": {
                  "enum": [
                    "income",
                    "expense",
                    "refund"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "baseAmountMinor": false,
              "baseCurrency": false,
              "rate": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "not": {
                  "enum": [
                    "transfer"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "toAmountMinor": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "not": {
                  "enum": [
                    "debt_out",
                    "debt_in"
                  ]
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "debtId": false,
              "debtAmountMinor": false
            }
          }
        }
      ]
    },
