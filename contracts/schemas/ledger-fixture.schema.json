          "$ref": "#/$defs/id"
        },
        "toAccountId": {
          "$ref": "#/$defs/id"
        },
        "toAmountMinor": {
          "$ref": "#/$defs/fieldMoney"
        },
        "note": {
          "$ref": "#/$defs/note"
        },
        "tagIds": {
          "$ref": "#/$defs/tagIds"
        }
      }
    },
    "recurringRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "template",
        "frequency",
        "interval",
        "startDate",
        "active"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/label80"
        },
        "template": {
          "oneOf": [
            {
              "$ref": "#/$defs/expenseTemplate"
            },
            {
              "$ref": "#/$defs/incomeTemplate"
            },
            {
              "$ref": "#/$defs/transferTemplate"
            }
          ]
