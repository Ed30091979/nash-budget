        "properties": {
          "code": {
            "$ref": "#/$defs/currency"
          },
          "exponent": {
            "enum": [
              0,
              2,
              3
            ]
          }
        }
      }
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "expected": {
      "$ref": "#/$defs/expected"
    }
  },
  "$defs": {
