        "currency",
        "openingMinor",
        "active"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "counterparty": {
          "$ref": "#/$defs/label80"
        },
        "direction": {
          "enum": [
            "i_owe",
            "owed_to_me"
          ]
        },
        "currency": {
          "$ref": "#/$defs/currency"
        },
        "openingMinor": {
          "$ref": "#/$defs/openingDebtMoney"
        },
        "dueDate": {
          "$ref": "#/$defs/date"
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "expenseTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "amountMinor",
        "accountId",
        "categoryId"
      ],
      "properties": {
        "kind": {
          "const": "expense"
        },
        "amountMinor": {
          "$ref": "#/$defs/fieldMoney"
        },
        "accountId": {
          "$ref": "#/$defs/id"
        },
        "categoryId": {
          "$ref": "#/$defs/id"
        },
        "note": {
          "$ref": "#/$defs/note"
        },
        "tagIds": {
          "$ref": "#/$defs/tagIds"
        }
      }
    },
    "incomeTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "amountMinor",
        "accountId"
      ],
      "properties": {
        "kind": {
          "const": "income"
        },
        "amountMinor": {
          "$ref": "#/$defs/fieldMoney"
        },
        "accountId": {
          "$ref": "#/$defs/id"
        },
        "categoryId": {
          "$ref": "#/$defs/id"
        },
        "note": {
          "$ref": "#/$defs/note"
        },
        "tagIds": {
          "$ref": "#/$defs/tagIds"
