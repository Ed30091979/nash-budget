        "linkedAccountId": {
          "$ref": "#/$defs/id"
        },
        "targetMinor": {
          "$ref": "#/$defs/nonNegativeMoney"
        },
        "openingContributedMinor": {
          "$ref": "#/$defs/nonNegativeMoney"
        },
        "plannedContributionMinor": {
          "$ref": "#/$defs/nonNegativeMoney"
        },
        "status": {
          "enum": [
            "active",
            "completed",
            "cancelled"
          ]
        },
        "deadline": {
          "$ref": "#/$defs/date"
