          "type": "boolean"
        },
        "sortOrder": {
          "$ref": "#/$defs/sortOrder"
        },
        "icon": {
          "$ref": "#/$defs/displayKey"
        },
        "color": {
          "$ref": "#/$defs/displayKey"
        },
