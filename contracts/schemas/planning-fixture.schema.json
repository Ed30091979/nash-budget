{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:family-budget:contracts:planning-fixture:1.0.0",
  "title": "Family budget planning golden fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "title", "startMonth", "horizonMonths", "minorUnit", "state", "expected"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "fixtureId": { "const": "G-002" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "startMonth": { "$ref": "#/$defs/month" },
    "horizonMonths": { "const": 24 },
    "minorUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "exponent"],
      "properties": {
        "currency": { "const": "RUB" },
        "exponent": { "const": 2 }
      }
    },
    "state": { "$ref": "#/$defs/state" },
    "expected": { "$ref": "#/$defs/expected" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "month": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
    "money": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "nonNegativeMoney": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveMoney": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "currency", "openingBalanceMinor", "active"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": { "enum": ["current", "cash", "savings", "reserve"] },
        "currency": { "const": "RUB" },
        "openingBalanceMinor": { "$ref": "#/$defs/money" },
        "active": { "type": "boolean" }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "group", "active", "sortOrder"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": { "enum": ["income", "expense"] },
        "group": { "type": "string", "minLength": 1, "maxLength": 200 },
        "active": { "type": "boolean" },
        "sortOrder": { "type": "integer" }
      }
    },
    "budgetLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "categoryId", "plannedMinor"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "categoryId": { "$ref": "#/$defs/id" },
        "plannedMinor": { "$ref": "#/$defs/nonNegativeMoney" },
        "rolloverMinor": { "$ref": "#/$defs/nonNegativeMoney" },
        "adjustmentMinor": { "$ref": "#/$defs/money" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startDate", "endDate", "status", "plannedIncomeMinor", "warningThreshold", "lines"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "startDate": { "$ref": "#/$defs/date" },
        "endDate": { "$ref": "#/$defs/date" },
        "status": { "enum": ["draft", "open", "closed"] },
        "plannedIncomeMinor": { "$ref": "#/$defs/nonNegativeMoney" },
        "warningThreshold": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "lines": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/budgetLine" } }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "linkedAccountId", "targetMinor", "openingContributedMinor", "plannedContributionMinor", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "linkedAccountId": { "$ref": "#/$defs/id" },
        "targetMinor": { "$ref": "#/$defs/nonNegativeMoney" },
        "openingContributedMinor": { "$ref": "#/$defs/nonNegativeMoney" },
        "plannedContributionMinor": { "$ref": "#/$defs/nonNegativeMoney" },
        "status": { "enum": ["active", "completed", "cancelled"] }
      }
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "categoryId", "accountId", "dueDate", "amountMinor", "reservedMinor", "recurrence", "active"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "categoryId": { "$ref": "#/$defs/id" },
        "accountId": { "$ref": "#/$defs/id" },
        "dueDate": { "$ref": "#/$defs/date" },
        "amountMinor": { "$ref": "#/$defs/positiveMoney" },
        "reservedMinor": { "$ref": "#/$defs/nonNegativeMoney" },
        "recurrence": { "enum": ["annual", "one_time"] },
        "active": { "type": "boolean" }
      }
    },
    "scheduledExpense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "categoryId", "accountId", "amountMinor", "dueDay", "mode", "active"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "categoryId": { "$ref": "#/$defs/id" },
        "accountId": { "$ref": "#/$defs/id" },
        "amountMinor": { "$ref": "#/$defs/positiveMoney" },
        "dueDay": { "type": "integer", "minimum": 1, "maximum": 31 },
        "mode": { "enum": ["monthly", "selected_months"] },
        "months": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "active": { "type": "boolean" }
      },
      "allOf": [{
        "if": { "properties": { "mode": { "const": "selected_months" } }, "required": ["mode"] },
        "then": { "required": ["months"] }
      }]
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "occurredOn", "status", "kind", "amountMinor"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "occurredOn": { "$ref": "#/$defs/date" },
        "status": { "enum": ["posted", "pending", "draft"] },
        "kind": { "enum": ["income", "expense", "refund", "transfer", "goal_contribution"] },
        "amountMinor": { "$ref": "#/$defs/positiveMoney" },
        "accountId": { "$ref": "#/$defs/id" },
        "categoryId": { "$ref": "#/$defs/id" },
        "fromAccountId": { "$ref": "#/$defs/id" },
        "toAccountId": { "$ref": "#/$defs/id" },
        "goalId": { "$ref": "#/$defs/id" },
        "originalTransactionId": { "$ref": "#/$defs/id" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["income", "expense", "refund"] } }, "required": ["kind"] },
          "then": { "required": ["accountId"] }
        },
        {
          "if": { "properties": { "kind": { "enum": ["expense", "refund"] } }, "required": ["kind"] },
          "then": { "required": ["categoryId"] }
        },
        {
          "if": { "properties": { "kind": { "const": "refund" } }, "required": ["kind"] },
          "then": { "required": ["originalTransactionId"] }
        },
        {
          "if": { "properties": { "kind": { "enum": ["transfer", "goal_contribution"] } }, "required": ["kind"] },
          "then": { "required": ["fromAccountId", "toAccountId"] }
        },
        {
          "if": { "properties": { "kind": { "const": "goal_contribution" } }, "required": ["kind"] },
          "then": { "required": ["goalId"] }
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeBudgetId", "accounts", "categories", "budgets", "goals", "annualCommitments", "scheduledExpenses", "transactions"],
      "properties": {
        "activeBudgetId": { "$ref": "#/$defs/id" },
        "accounts": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/account" } },
        "categories": { "type": "array", "minItems": 1, "maxItems": 5000, "items": { "$ref": "#/$defs/category" } },
        "budgets": { "type": "array", "minItems": 1, "maxItems": 120, "items": { "$ref": "#/$defs/budget" } },
        "goals": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/goal" } },
        "annualCommitments": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/commitment" } },
        "scheduledExpenses": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/scheduledExpense" } },
        "transactions": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/transaction" } }
      }
    },
    "monthMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["month", "plannedIncomeMinor", "scheduledExpenseMinor", "seasonalExpenseMinor", "flexiblePlanMinor", "annualReserveMinor", "annualDueMinor", "goalPlanMinor", "spendableAfterPlanMinor"],
      "properties": {
        "month": { "$ref": "#/$defs/month" },
        "plannedIncomeMinor": { "$ref": "#/$defs/nonNegativeMoney" },
        "scheduledExpenseMinor": { "$ref": "#/$defs/nonNegativeMoney" },
        "seasonalExpenseMinor": { "$ref": "#/$defs/nonNegativeMoney" },
        "flexiblePlanMinor": { "$ref": "#/$defs/nonNegativeMoney" },
        "annualReserveMinor": { "$ref": "#/$defs/nonNegativeMoney" },
        "annualDueMinor": { "$ref": "#/$defs/nonNegativeMoney" },
        "goalPlanMinor": { "$ref": "#/$defs/nonNegativeMoney" },
        "spendableAfterPlanMinor": { "$ref": "#/$defs/money" }
      }
    },
    "commitmentMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitmentId", "monthsUntilDue", "remainingToReserveMinor", "monthlyReserveMinor", "status"],
      "properties": {
        "commitmentId": { "$ref": "#/$defs/id" },
        "monthsUntilDue": { "type": "integer" },
        "remainingToReserveMinor": { "$ref": "#/$defs/nonNegativeMoney" },
        "monthlyReserveMinor": { "$ref": "#/$defs/nonNegativeMoney" },
        "status": { "enum": ["funded", "on_track", "due_soon", "overdue"] }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstTwelveMonthsEqual", "months", "commitments"],
      "properties": {
        "firstTwelveMonthsEqual": { "const": true },
        "months": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "$ref": "#/$defs/monthMetrics" } },
        "commitments": { "type": "array", "minItems": 1, "maxItems": 5000, "items": { "$ref": "#/$defs/commitmentMetrics" } }
      }
    }
  }
}
