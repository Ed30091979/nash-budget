<?xml version="1.0" encoding="utf-8"?>
<!--
    Палитра обёртки — три значения `:root` из apps/web-pwa/src/styles.css, и только они.
    Всё, что Android рисует до первого кадра страницы (фон окна, заставка, строка состояния,
    навигационная панель, подложка значка), берёт цвет отсюда; hex нигде больше в ресурсах не
    пишется. Совпадение с таблицей стилей сверяют scripts/brand-palette.mjs и его тест.
-->
<resources>
    <!-- `- -canvas`: тёплый холст под карточками. -->
    <color name="canvas">#F6F3EE</color>
    <!-- `- -ink`: чернила. -->
    <color name="ink">#171410</color>
    <!-- `- -orange`: единственная цветная роль приложения. -->
    <color name="orange">#B8471A</color>
</resources>
