<?xml version="1.0" encoding="utf-8"?>
<!--
    Оверлей, который добавляется к главному манифесту только в сборке с настроенным адресом
    сервера семьи. Решение принимает `app/build.gradle` по политике упакованного `index.html`.

    Здесь ровно одно разрешение и ничего больше. Без `INTERNET` WebView не открывает ни одного
    сокета, и синхронизация в Android-сборке не работает вовсе; с ним — в сборке по умолчанию,
    у которой адреса сервера нет, — приложение просило бы у пользователя право, которым не
    пользуется, и карточка магазина перестала бы быть правдой. Поэтому разрешение не в главном
    манифесте, а тут.

    Открытый доступ в сеть этим не появляется: cleartext запрещён в network_security_config, а
    `connect-src` в политике страницы называет один адрес — тот, что задан сборке.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
